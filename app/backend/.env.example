# ─── Flask Core ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
FLASK_ENV=development             # development | production | testing

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_COOKIE_SECURE=false           # set to true in production (HTTPS only)
# Cross-subdomain auth (API on api.hubra.club, frontend on app.hubra.club):
JWT_COOKIE_SAMESITE=Lax           # Lax: same registrable domain → cookies sent cross-subdomain
JWT_COOKIE_DOMAIN=.hubra.club   # leading dot = all subdomains; omit for single-host dev
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# CSRF double-submit cookie pattern (flask-jwt-extended):
# When JWT_COOKIE_CSRF_PROTECT=true, non-HttpOnly csrf_access_token and
# csrf_refresh_token cookies are set. The frontend reads these and sends
# the value as X-CSRF-TOKEN header on state-changing requests.
# JWT_COOKIE_CSRF_PROTECT=true   # default: true (disabled in TestingConfig)
# JWT_CSRF_CHECK_REFRESH=true    # default: true — CSRF-validate refresh path too
# CSRF_EXEMPT_PATHS=             # comma-separated paths exempt from CSRF

# ─── Database ─────────────────────────────────────────────────────────────────
# Defaults to SQLite for local dev; set PostgreSQL URL for staging/prod
DATABASE_URL=sqlite:///dev.db
# DATABASE_URL=postgresql://user:password@localhost:5432/club_db

# PostgreSQL (used by docker-compose to build DATABASE_URL)
POSTGRES_DB=club_db
POSTGRES_USER=club_user
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=5000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (plural). No wildcards — only these origins
# are reflected with Allow-Credentials: true and Vary: Origin.
CORS_ORIGINS=http://localhost:5173
# Frontend origin for email links (password-reset, verify-email) → opens the SPA.
FRONTEND_BASE_URL=http://localhost:5173

# ─── Redis (optional — rate limiting, caching) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE=memory         # memory | redis

# ─── Mail / WildDuck ──────────────────────────────────────────────────────────
WILDDUCK_API_URL=http://localhost:8080
WILDDUCK_API_TOKEN=change-me-wildduck-token
SMTP_HOST=localhost
SMTP_PORT=587
IMAP_HOST=localhost
IMAP_PORT=143
MAIL_FROM=noreply@example.com
MAIL_HOST=mail.example.com
CLUB_DOMAIN=example.com

# ─── Integrations ─────────────────────────────────────────────────────────────
API_BOT_KEY=change-me-bot-key
DISCORD_WEBHOOK_URL=

# ─── TLS / ACME ───────────────────────────────────────────────────────────────
ACME_EMAIL=admin@example.com
LOOP_SECRET=change-me-loop-secret

# ─── Backups (Contabo S3) ─────────────────────────────────────────────────────
# S3 connection — also editable via Settings UI (backup namespace).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=default
# GPG encryption passphrase — .env ONLY, never stored in DB.
BACKUP_ENCRYPTION_KEY=
