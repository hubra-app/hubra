# NOTE: (proxy_headers) / (backend_proxy) snippets were used when Caddy proxied
# /api/* to the backend (Traefik -> Caddy -> Flask, two hops, ProxyFix x_for=2).
# The API now lives on api.hubra.club and routes directly Traefik -> backend:5000
# (one hop, ProxyFix x_for=1 in wsgi.py). Caddy only fronts the frontend SPA on
# app.hubra.club, so these snippets are retained for reference but no longer
# referenced by the :80 server block below.

(proxy_headers) {
  # Legacy: forwarded-header passthrough for the old Traefik -> Caddy -> Flask path.
  #header_up X-Real-IP {remote_host}
  # X-Forwarded-Proto: let upstream set it (Traefik in prod, absent in dev)
  #header_up X-Forwarded-Proto https

  header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
  header_up X-Real-IP {http.request.header.X-Real-IP}
  header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
}

(backend_proxy) {
  import proxy_headers

  # Single upstream — no point retrying the same host
  lb_retries 0

  # Fail fast on unreachable backend
  transport http {
    dial_timeout 1s
    response_header_timeout 30s
  }

  # Passive health checks: after 3 failures within 30s,
  # mark upstream as down and return 502 immediately
  # fail_duration 30s
  # max_fails 10
  # unhealthy_status 5xx
}

:80 {
  header {
    # Security headers for frontend HTML (moved from Flask API responses)
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' fonts.googleapis.com 'unsafe-inline'; img-src 'self' data:; font-src 'self' data: fonts.gstatic.com; connect-src 'self' https://api.hubra.club; frame-ancestors 'none'"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Accept-CH "Sec-CH-UA-Arch, Sec-CH-UA-Bitness, Sec-CH-UA-Platform-Version, Sec-CH-UA-Model, Device-Memory"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  # Frontend SPA — API calls go directly to api.hubra.club (Traefik → backend)
  reverse_proxy * frontend:80
}
