# Hubra environment for Docker Compose (docker-compose.yml) and for the
# k3s Secret `hubra-env` (deploy/create-secrets.sh reads the same file).
#
# Quick start: `scripts/init-env.sh` copies this file to .env and fills every
# empty secret below with a random value. Or copy it by hand and generate them:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# The defaults run the stack on localhost (ports 8080/8081/8082, plain HTTP).
# For real host names, see the "Production" blocks.

# ── Images ────────────────────────────────────────────────────────────────────
# Prebuilt images from GitHub Actions. Pin HUBRA_VERSION to a release tag or a
# sha-<commit> tag to stay on one build.
HUBRA_IMAGE_PREFIX=ghcr.io/hubra-app/hubra
HUBRA_VERSION=latest
# Interface the frontend ports bind to. 0.0.0.0 exposes them on the network.
HUBRA_BIND=127.0.0.1

# ── Flask / JWT (required) ────────────────────────────────────────────────────
SECRET_KEY=
JWT_SECRET_KEY=
# Fernet key for secrets at rest (required in production):
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
# Old keys, still read while `flask crypto rotate` moves everything to
# FERNET_KEY (comma-separated). See docs/operator-guide.md.
FERNET_OLD_KEYS=
FLASK_ENV=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# docker-compose.yml builds DATABASE_URL from these.
POSTGRES_DB=hubra
POSTGRES_USER=hubra
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
RATE_LIMIT_STORAGE=redis://:${REDIS_PASSWORD}@redis:6379/1

# ── URLs ──────────────────────────────────────────────────────────────────────
# Where each app is reached in the browser. Used for links in e-mails and for
# the links between the three apps.
FRONTEND_BASE_URL=http://localhost:8080
MANAGE_BASE_URL=http://localhost:8081
SSO_BASE_URL=http://localhost:8082
# API base the SPAs call. "/api" means "same origin": each frontend container
# proxies /api/ to the backend.
VITE_API_BASE=/api

# Platform superadmins (comma-separated login emails). The init job's
# `flask ensure-superadmins` promotes these accounts on every start once they
# exist; it never demotes anyone. `flask make-admin --email <email>` does the
# same by hand.
SUPERADMIN_EMAILS=

# Every origin that calls the API from a browser (comma-separated, no wildcards).
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082

# Cookies. Plain HTTP on localhost needs JWT_COOKIE_SECURE=false and no domain.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_DOMAIN=

# Production (example for hubra.club with docker-compose.traefik.yml):
#   FRONTEND_BASE_URL=https://app.hubra.club
#   MANAGE_BASE_URL=https://manage.hubra.club
#   SSO_BASE_URL=https://sso.hubra.club
#   VITE_API_BASE=https://api.hubra.club/api
#   CORS_ORIGINS=https://app.hubra.club,https://manage.hubra.club,https://sso.hubra.club,https://join.hubra.club
#   JWT_COOKIE_SECURE=true
#   JWT_COOKIE_DOMAIN=.hubra.club
#   API_PUBLIC_URL=https://api.hubra.club

# ── Discord (optional; one Hubra bot for every club, see docs/discord.md) ────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
#   COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
#
# Traefik host names for docker-compose.traefik.yml (default: *.hubra.club).
# The existing vollbuild.ch server keeps its hosts with:
#   HUBRA_APP_HOST=cos.vollbuild.ch
#   HUBRA_MANAGE_HOST=manage.vollbuild.ch
#   HUBRA_SSO_HOST=sso.vollbuild.ch
#   HUBRA_JOIN_HOST=join.vollbuild.ch
#   HUBRA_API_HOST=api.vollbuild.ch
# plus the vollbuild.ch values of the URLs, CORS_ORIGINS and JWT_COOKIE_DOMAIN
# above (https://cos.vollbuild.ch, ..., JWT_COOKIE_DOMAIN=.vollbuild.ch).

# Trust X-Forwarded-For from a proxy in front of the frontend containers
# (CIDR list). Leave empty when the containers face clients directly.
REAL_IP_FROM=

# Content-Security-Policy of the three web apps. Empty = the built-in policy
# (own origin, the API origin of VITE_API_BASE, Google Fonts); "off" sends
# none. Set a full policy here if you load scripts from elsewhere.
CSP=

# ── Logging / tokens ──────────────────────────────────────────────────────────
JSON_LOGGING=true
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── Mail via an external provider (SMTP/IMAP) ─────────────────────────────────
# Leave empty to run without mail. For the self-hosted stack, see
# modules/mail/README.md.
# Platform relay for every mail Hubra sends (sign-in, SSO, club mail).
# These are defaults: the manager portal can override them per install.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional second relay, used when the first refuses a mail (e.g. its send
# quota is reached). Brevo: smtp-relay.brevo.com, port 587, your Brevo login
# and SMTP key. The sender domain must be verified there too.
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
# Sender of system mail (sign-in, SSO, platform notices).
MAIL_FROM=
MAIL_HOST=
MAIL_DOMAIN=

# ── Self-hosted mail stack (modules/mail/docker-compose.mail.yml only) ────────
MONGO_USER=hubra
MONGO_PASSWORD=
WILDDUCK_API_TOKEN=
# Leave empty without the mail stack; with it: http://mailserver:8080
WILDDUCK_API_URL=
LOOP_SECRET=
SRS_SECRET=
REWRITE_DOMAIN=
ACME_EMAIL=
MAIL_CERT_DOMAINS=
NODE_ENV=production
APPCONF_dbs_sender=zone-mta
APPCONF_api_host=0.0.0.0
APPCONF_api_port=8080
APPCONF_webhooks_enabled=false
# Compose only: cert-watcher restarts these containers through socket-proxy
# when certificates are renewed (names as `docker ps` shows them).
SOCKET_PROXY_CONTAINERS=1
SOCKET_PROXY_RESTART=1
CERT_WATCHER_DOCKER_HOST=tcp://socket-proxy:2375
CERT_WATCHER_ALLOWED_CONTAINERS="hubra-mailserver-1 hubra-haraka-1 hubra-zonemta-1"
CERT_WATCHER_RESTART_CONTAINERS="hubra-mailserver-1 hubra-haraka-1 hubra-zonemta-1"
CERT_WATCHER_WATCH_DIR=/etc/letsencrypt
CERT_WATCHER_SETTLE_SECONDS=3
CERT_WATCHER_POLL_INTERVAL=300

# ── Discord ───────────────────────────────────────────────────────────────────
API_BOT_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Backups (S3) ──────────────────────────────────────────────────────────────
# Defaults for manage > Platform Settings > Backup storage, which can
# override them for the whole platform.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=default
# age public key backups are encrypted to (`flask backups keygen` or
# `age-keygen`). The private key stays OFF the server, in a password manager;
# restore asks for it. If it is lost, the backups cannot be decrypted.
BACKUP_PUBLIC_KEY=
# Optional: the private key on the server, so verify/restore don't ask.
# Convenient, but a break-in on the server then opens every backup.
BACKUP_PRIVATE_KEY=
# Older GPG passphrase: used for new backups only without BACKUP_PUBLIC_KEY,
# and still opens .dump.gpg backups made with it.
BACKUP_ENCRYPTION_KEY=
