# Copy this file to .env and fill in real values before starting the app.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
#
# For local development: create a .env.dev file with dev-friendly overrides
# (JWT_COOKIE_SECURE=false, no JWT_COOKIE_DOMAIN, sqlite, etc.).
# config.py auto-loads .env.dev with override=True when FLASK_ENV=development.
# .env.dev is gitignored — see .env.example for the list of variables.

# Flask / JWT — REQUIRED, no default in production
SECRET_KEY=
JWT_SECRET_KEY=

# Fernet encryption key (codes at rest) — recommended in production
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If not set, derived from SECRET_KEY (legacy, not recommended)
FERNET_KEY=

# Database — REQUIRED
DATABASE_URL=postgresql://club_user:change-me-postgres@localhost:5432/club_db

# Environment: development | production | testing
FLASK_ENV=development

# Frontend API base URL — absolute URL for cross-origin API access
# Local dev: http://localhost:5000/api (in app/frontend/.env)
# Production: set here; docker-compose.override.yaml references ${VITE_API_BASE}
VITE_API_BASE=https://api.vollbuild.ch/api

# CORS — comma-separated allowed origins (plural; CORS_ORIGIN singular still accepted as fallback)
# No wildcards. Reflects ONLY these origins with Allow-Credentials: true + Vary: Origin.
# Add every frontend origin that calls the API. The apex (vollbuild.ch) is included
# only if it also serves the SPA; remove it if only cos.vollbuild.ch is used.
CORS_ORIGINS=https://vollbuild.ch,https://cos.vollbuild.ch,https://manage.vollbuild.ch,https://sso.vollbuild.ch,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Frontend origin — used to build links in transactional emails (password-reset,
# email-verification) that must open the SPA, not the API host. The API lives on
# api.vollbuild.ch so request.url_root must NOT be used for these links.
FRONTEND_BASE_URL=https://cos.vollbuild.ch

# SSO portal origin — used for auth-related email links (password-reset,
# email-verification) that point to the SSO portal. Falls back to
# FRONTEND_BASE_URL when not set.
SSO_BASE_URL=https://sso.vollbuild.ch

# JWT cookies — cross-subdomain auth (frontend on cos.vollbuild.ch, API on api.vollbuild.ch)
JWT_COOKIE_SECURE=true              # set to false only for local HTTP dev
JWT_COOKIE_SAMESITE=Lax             # Lax allows cross-subdomain cookie delivery (same registrable domain)
JWT_COOKIE_DOMAIN=.vollbuild.ch     # leading dot = all subdomains; omit for single-host setup

# Redis
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0

# Rate limiting storage (uses REDIS_URL when set, falls back to memory)
RATE_LIMIT_STORAGE=redis://:${REDIS_PASSWORD}@localhost:6379/1

# Brevo transactional email (use this when the mail feature is disabled)
BREVO_API_KEY=

# ── Mail (required only if features.mail=true) ──
# Mail is handled via Infomaniak IMAP/SMTP. Configure these with your
# Infomaniak mail credentials. If you are not using mail, leave these blank.

# SMTP / IMAP (Infomaniak mail)
SMTP_HOST=
SMTP_PORT=587
IMAP_HOST=
IMAP_PORT=993
MAIL_FROM=
MAIL_HOST=
MAIL_DOMAIN=

# Discord bot
API_BOT_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Logging
JSON_LOGGING=true

# JWT token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── Backups (Contabo S3) ──────────────────────────────────────────────────────
# S3 connection — also editable via Settings UI (backup namespace).
# Env vars are the fallback; KV settings take precedence when populated.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=default
# GPG encryption passphrase — .env ONLY, never stored in DB.
# If this is lost, backups cannot be decrypted. Store in a password manager.
BACKUP_ENCRYPTION_KEY=

# ── Docker Compose: app stack (docker-compose.override.yaml) ──────────────────
# VITE_API_BASE — see above (production value referenced by the frontend service)
# FRONTEND_BASE_URL — see above (used by the backend via env_file)
# JWT_COOKIE_DOMAIN / JWT_COOKIE_SAMESITE / JWT_COOKIE_SECURE — see JWT section above
# CORS_ORIGINS — see CORS section above (apex + cos subdomain + localhost)
