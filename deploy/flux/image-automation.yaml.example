# Rename to image-automation.yaml to switch on Flux image automation
# (see deploy/flux-image-automation/image-automation.yaml for the prerequisites).
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: image-automation
  namespace: flux-system
spec:
  interval: 10m
  sourceRef:
    kind: GitRepository
    name: flux-system
  path: ./deploy/flux-image-automation
  prune: true
