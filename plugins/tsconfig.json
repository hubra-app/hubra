{
  // Type-checks the plugins' frontends against the club app:
  //   cd app/frontend && npm run typecheck:plugins
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "typeRoots": ["../app/frontend/node_modules/@types", "../app/frontend/node_modules"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@hubra/plugin-sdk": ["../app/frontend/src/plugins/sdk.ts"],
      "@hubra/api-client": ["../packages/api-client/src/index.ts"],
      "@/*": ["../app/frontend/src/*"],
      "*": ["../app/frontend/node_modules/@types/*", "../app/frontend/node_modules/*"]
    }
  },
  "include": ["*/frontend/src"]
}
