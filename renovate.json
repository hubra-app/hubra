{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorMinor",
    ":combinePatchMinorUpdates",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ],
  "docker": {
    "pinDigests": true
  },
  "npm": {
    "extends": ["npm:unpublishSafe"]
  },
  "pip_requirements": {
    "enabled": true,
    "managerFilePatterns": ["/(^|/)requirements\\.lock$/", "/(^|/)requirements(-dev)?\\.txt$/"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
